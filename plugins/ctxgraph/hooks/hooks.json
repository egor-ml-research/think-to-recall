{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"think-to-recall @ git+https://github.com/egor-ml-research/think-to-recall@1acb3f324731f32cffeba62368aa4e0914e50005\" ctxgraph hook-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"think-to-recall @ git+https://github.com/egor-ml-research/think-to-recall@1acb3f324731f32cffeba62368aa4e0914e50005\" ctxgraph hook-start",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
