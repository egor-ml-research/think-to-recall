{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from think-to-recall==0.6.10 ctxgraph hook-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from think-to-recall==0.6.10 ctxgraph hook-start",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
