{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"think-to-recall @ git+https://github.com/egor-ml-research/think-to-recall@77f7b1215b3b8eca27b47ccf48f9c87809189091\" ctxgraph hook-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"think-to-recall @ git+https://github.com/egor-ml-research/think-to-recall@77f7b1215b3b8eca27b47ccf48f9c87809189091\" ctxgraph hook-start",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
