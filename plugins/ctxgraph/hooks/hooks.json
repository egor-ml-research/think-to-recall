{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"think-to-recall @ git+https://github.com/egor-ml-research/think-to-recall@911342c6598de44c4f210c272c3522bc227e1c54\" ctxgraph hook-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"think-to-recall @ git+https://github.com/egor-ml-research/think-to-recall@911342c6598de44c4f210c272c3522bc227e1c54\" ctxgraph hook-start",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
